# ===========================================================================
# CivicLens AI — Environment Variables
# ===========================================================================
# Copy this file to .env and set your own values.
# NEVER commit the real .env file to version control.
# ---------------------------------------------------------------------------

# SQLite database file path (relative to project root).
# For PostgreSQL in production: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./civiclens.db

# Directory where uploaded images are stored.
UPLOAD_DIR=uploads

# Maximum upload size in megabytes.
MAX_UPLOAD_SIZE_MB=5

# Comma-separated list of allowed image MIME types.
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# CORS origins allowed to call the API (use * for any, or comma-separated list).
CORS_ORIGINS=*
